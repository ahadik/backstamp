{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for backstamp",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:read-files",
    "fs:write-files",
    "fs:allow-app-write"
  ]
}
