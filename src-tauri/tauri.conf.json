{
  "productName": "Backstamp",
  "version": "0.2.3",
  "identifier": "com.alexhadik.backstamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Backstamp",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPDATA/backstamp/thumbnails/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/exiftool", "resources/lib", "resources/exiftool.config"],
      "macOS": {
      "signingIdentity": "Developer ID Application: Alexander Hadik (4S36HK7MB2)",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "single-instance": null
  }
}
